<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- ไล่เฉดสีกระจกอุ่นๆ ให้เข้ากับพื้นหลังสีครีมมินิมอล -->
    <gradient
        android:startColor="#D5C8C8C8"
        android:endColor="#33D3B07B"
        android:angle="135" />

    <!-- ขอบสะท้อนแสงสองโทน (ใช้ขอบขาวนวลตัดเงาอ่อน) -->
    <stroke
        android:width="1dp"
        android:color="#D9FFFFFF" />

    <!-- ทรงแคปซูลโค้งมนฝั่งซ้าย แนบชิดขอบจอฝั่งขวา -->
    <corners
        android:topLeftRadius="20dp"
        android:bottomLeftRadius="20dp"
        android:topRightRadius="0dp"
        android:bottomRightRadius="0dp" />

    <!-- ระยะห่างภายในปุ่ม -->
    <padding
        android:left="8dp"
        android:top="12dp"
        android:right="4dp"
        android:bottom="12dp" />

</shape>