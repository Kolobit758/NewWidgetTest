<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_rounded_background"
    android:clipToOutline="true">

    <!-- 1. Background -->
    <ImageView
        android:id="@+id/catiBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/minimal_bg"/>

    <!-- 2. Tap grid container for background clicks -->
    <LinearLayout
        android:id="@+id/tapGridContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical" />

    <!-- 3. Items falling overlay -->
    <FrameLayout
        android:id="@+id/itemContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/itemImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="item" />
    </FrameLayout>

    <!-- 3.5. Item Selection Drawer Overlay -->
    <FrameLayout
        android:id="@+id/itemDrawerRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/drawerTabContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="0dp"
            android:background="@drawable/drawer_tab_paw_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:elevation="4dp">

            <ImageView
                android:id="@+id/imgIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_cat_paw_white"
                android:scaleType="fitCenter"
                android:contentDescription="cat paw drawer tab" />

        </LinearLayout>

        <!-- Expanded drawer panel -->
        <FrameLayout
            android:id="@+id/drawerPanelContainer"
            android:layout_width="@dimen/drawer_panel_width"
            android:layout_height="@dimen/drawer_panel_height"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="@dimen/drawer_edge_inset"
            android:visibility="gone">

            <ImageView
                android:id="@+id/drawerBackdrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/custom_drawer_bg"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="drawer backdrop" />

            <!-- 5 ช่องไอเทมเรียงตั้ง -->
            <LinearLayout
                android:id="@+id/drawerContentContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="@dimen/drawer_vertical_padding"
                android:paddingBottom="@dimen/drawer_vertical_padding">

                <!-- 1. Wand (บอล) -->
                <LinearLayout
                    android:id="@+id/btnItemWand"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center">
                    <ImageView
                        android:id="@+id/itemIconWand"
                        android:layout_width="@dimen/drawer_slot_size"
                        android:layout_height="@dimen/drawer_slot_size"
                        android:padding="4dp"
                        android:background="@drawable/drawer_item_slot_bg"
                        android:scaleType="fitCenter"
                        android:src="@drawable/yarn" />
                </LinearLayout>

                <!-- 2. Box (กล่อง) -->
                <LinearLayout
                    android:id="@+id/btnItemBox"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center">
                    <ImageView
                        android:id="@+id/itemIconBox"
                        android:layout_width="@dimen/drawer_slot_size"
                        android:layout_height="@dimen/drawer_slot_size"
                        android:padding="4dp"
                        android:background="@drawable/drawer_item_slot_bg"
                        android:scaleType="fitCenter"
                        android:src="@drawable/cartonbox" />
                </LinearLayout>

                <!-- 3. Food (อาหาร) -->
                <LinearLayout
                    android:id="@+id/btnItemFood"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center">
                    <ImageView
                        android:id="@+id/itemIconFood"
                        android:layout_width="@dimen/drawer_slot_size"
                        android:layout_height="@dimen/drawer_slot_size"
                        android:padding="4dp"
                        android:background="@drawable/drawer_item_slot_bg"
                        android:scaleType="fitCenter"
                        android:src="@drawable/bowl" />
                </LinearLayout>

                <!-- 4. Cockroach (แมลงสาบ) -->
                <LinearLayout
                    android:id="@+id/btnItemCockroach"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center">
                    <ImageView
                        android:id="@+id/itemIconCockroach"
                        android:layout_width="@dimen/drawer_slot_size"
                        android:layout_height="@dimen/drawer_slot_size"
                        android:padding="4dp"
                        android:background="@drawable/drawer_item_slot_bg"
                        android:scaleType="fitCenter" />
                </LinearLayout>

                <!-- 5. Snake (งู) -->
                <LinearLayout
                    android:id="@+id/btnItemSnake"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center">
                    <ImageView
                        android:id="@+id/itemIconSnake"
                        android:layout_width="@dimen/drawer_slot_size"
                        android:layout_height="@dimen/drawer_slot_size"
                        android:padding="4dp"
                        android:background="@drawable/drawer_item_slot_bg"
                        android:scaleType="fitCenter" />
                </LinearLayout>

            </LinearLayout>
        </FrameLayout>

    </FrameLayout>

    <!-- 4. Interactive Cat & Status Speech Bubble Container -->
    <FrameLayout
        android:id="@+id/catContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:id="@+id/catImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:scaleType="fitCenter"
                android:src="@drawable/cat_idle"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="cat" />

            <!-- Status Speech Bubble Container -->
            <LinearLayout
                android:id="@+id/statusBubbleContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/widget_status_background"
                android:visibility="gone"
                android:padding="3dp"
                android:clickable="true"
                android:focusable="true"
                android:elevation="2dp">

                <ImageView
                    android:id="@+id/statusIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone"
                    android:contentDescription="status icon" />

                <TextView
                    android:id="@+id/chatBubble"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="140dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

        </FrameLayout>

    </FrameLayout>

    <!-- 5. Control Buttons -->
    <ImageButton
        android:id="@+id/btnMute"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="56dp"
        android:layout_marginTop="8dp"
        android:padding="9dp"
        android:background="@drawable/widget_control_background"
        android:contentDescription="Toggle cat sounds"
        android:src="@drawable/ic_volume_up" />

    <ImageView
        android:id="@+id/imgJumpscare"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:visibility="gone"
        android:contentDescription="Jumpscare Cat Face" />

    <!-- Background picker -->
    <ImageButton
        android:id="@+id/btnTestBg"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:background="@drawable/widget_control_background"
        android:src="@drawable/ic_widget_theme"
        android:contentDescription="Choose widget background"
        android:padding="9dp" />

</FrameLayout>
